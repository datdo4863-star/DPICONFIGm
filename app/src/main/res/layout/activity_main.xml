<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DPI CONFIG"
            android:textColor="#FFD700"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="4dp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Free Fire Max"
            android:textColor="#888888"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>
        <TextView
            android:id="@+id/tvShizukuStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Shizuku: Chua ket noi"
            android:textColor="#FF4444"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>
        <Button
            android:id="@+id/btnShizuku"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="KICH HOAT SHIZUKU"
            android:backgroundTint="#1A1A2E"
            android:textColor="#FFD700"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>
        <TextView
            android:id="@+id/tvDpiValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DPI Config: 0"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="12dp"/>
        <SeekBar
            android:id="@+id/seekBarDpi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:progressTint="#FFD700"
            android:thumbTint="#FFD700"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="-7"
                android:textColor="#666666"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0"
                android:textColor="#666666"
                android:gravity="center"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="+7"
                android:textColor="#666666"
                android:gravity="end"/>
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PRESET"
            android:textColor="#FFD700"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>
        <RadioGroup
            android:id="@+id/radioPresets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">
            <RadioButton
                android:id="@+id/r1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Nhe tay"
                android:textColor="#CCCCCC"
                android:textSize="11sp"
                android:buttonTint="#FFD700"/>
            <RadioButton
                android:id="@+id/r2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Can bang"
                android:textColor="#CCCCCC"
                android:textSize="11sp"
                android:buttonTint="#FFD700"/>
            <RadioButton
                android:id="@+id/r3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Bam tam"
                android:textColor="#CCCCCC"
                android:textSize="11sp"
                android:buttonTint="#FFD700"/>
            <RadioButton
                android:id="@+id/r4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sieu ba"
                android:textColor="#FFD700"
                android:textSize="11sp"
                android:buttonTint="#FFD700"/>
        </RadioGroup>
        <Button
            android:id="@+id/btnApply"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="CAI DPI CONFIG"
            android:backgroundTint="#FFD700"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="12dp"/>
        <Button
            android:id="@+id/btnLaunchFFM"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="VAO FREE FIRE MAX"
            android:backgroundTint="#FF4444"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="20dp"/>
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#AAAAAA"
            android:textSize="13sp"
            android:gravity="center"/>
    </LinearLayout>
</ScrollView>
